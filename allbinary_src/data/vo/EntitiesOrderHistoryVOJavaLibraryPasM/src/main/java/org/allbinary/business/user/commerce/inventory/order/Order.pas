        hashMap.put(TStoreFrontData.getInstance().NAME, Self.storeName);
        hashMap.put(TEntryData.getInstance().SPECIAL, Self.special);
        hashMap.put(TOrderData.ID, Self.id);
        hashMap.put(TOrderData.CUSTOMERCOMMENT, Self.userComment);
        hashMap.put(TOrderData.CUSTOMERCANCELCOMMENT, Self.userCancelComment);
        hashMap.put(TOrderData.STORECOMMENT, Self.storeComment);
        hashMap.put(TOrderData.STORECANCELCOMMENT, Self.storeCancelComment);
        Exit(hashMap);
end;
    

// throws Exception
function TOrder.toXmlNode(document: TDocument): TNode;
var
  hashMap: TJavaHashMap;
  keySet: ISet;
  keyArray: TArray<TObject>;
  size: Integer;
  node: TNode;
  name: string;
  value: string;
  i: Integer;
begin
        hashMap := Self.toHashMapOrder();
        keySet := hashMap.keySet();
        keyArray := keySet.toArray();
        size := System.Length(keyArray);
        node := document.createElement(TOrderData.ORDER);
        for i := 0 to size - 1 do begin
            name := string(keyArray[i]);
            value := string(hashMap.get(name));
            value := TStringUtil.getInstance().getNonNull(value);
            node.appendChild(TModDomHelper.createNameValueNodes(document, name, value));
        end;
        Exit(node);
end;

initialization

