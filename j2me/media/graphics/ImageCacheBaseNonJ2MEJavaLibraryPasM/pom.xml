<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary</groupId>
    <artifactId>ImageCacheBaseNonJ2MEJavaLibraryPas</artifactId>
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>ImageCacheBaseNonJ2MEJavaLibraryPas</name>
    <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>
    <properties>
        <cygwin.home>G:/cygwin64</cygwin.home>
        <!-- Free Pascal compiler. The Windows installer default is C:/FPC/<version>/bin/<target> -->
        <fpc.executable>C:/FPC/3.2.2/bin/i386-win32/fpc.exe</fpc.executable>
        <fpc.compiler.flags>-O2 -vewn</fpc.compiler.flags>
        <opascal.jsinterop.source.path>G:/mnt/bc/mydev/workingopascal/replace_these_stub_projects/allbinary_src/J2MEJsInteropCompatibilityJavaLibraryPasM/src/main/java</opascal.jsinterop.source.path>
        <!-- Set to false to continue the Maven build when the generated Object Pascal does not compile -->
        <opascal.fail.on.error>true</opascal.fail.on.error>
    </properties>

    <dependencies>
        <!--
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>
        -->

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>J2MEJsInteropCompatibilityJavaLibraryPas</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-fpc-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${cygwin.home}/bin/bash.exe</executable>
                            <arguments>
                                <argument>${project.basedir}/build-cygwin.sh</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.outputDirectory}/META-INF/pascal</argument>
                                <argument>${fpc.executable}</argument>
                                <argument>${fpc.compiler.flags}</argument>
                                <argument>${opascal.fail.on.error}</argument>
                                <argument>${opascal.jsinterop.source.path}</argument>
                                <!-- Object Pascal dependency source paths start -->
                                <argument>G:/mnt/bc/mydev/AllBinary-Platform-Integrationopascal/embedded/j2me/microemulator/3.0.0/TempMIDPJavaLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/allbinary_src/LogJ2MEJavaLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/allbinary_src/LogNoPlatformJavaLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/allbinary_src/LogPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/CommonJavaLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/J2MEExceptionLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/J2MEUtilJavaLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/J2MEWindowingJavaLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/lib/BaseMathLibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/logging/LoggingJ2MEAllPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/logging/LoggingJ2MEExceptionPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/NullJ2MELibraryPasM/src/main/java</argument>
                                <argument>G:/mnt/bc/mydev/workingopascal/j2me/TempBaseJavaLibraryPasM/src/main/java</argument>
                                <!-- Object Pascal dependency source paths end -->
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>