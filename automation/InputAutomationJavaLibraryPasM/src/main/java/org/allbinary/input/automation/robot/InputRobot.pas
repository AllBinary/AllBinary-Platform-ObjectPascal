procedure TInputRobot.mouseMoveToTarget(rectangle: TRectangle; x: Integer; y: Integer);
var
  point: TPoint;
  message: string;
begin
        point := TPointHelper.getCenterPoint(rectangle);
        Self.robot.mouseMove((point.x) + (x), (point.y) + (y));
        message := TStringMaker.Create().append('Moved Mouse To: x: ').appendint(Integer(Trunc(point.x))).append(' y: ').appendint(Integer(Trunc(point.y))).append(' in the middle of: ').append(TStringUtil.getInstance().toString(rectangle)).toString();
        Self.logUtil.putF(message, Self, 'moveMouseToTarget');
end;
    

